# Copy to .env (never commit .env). Local values only; production values live on the server.
POSTGRES_PASSWORD=postgres_dev
DB_OWNER_PASSWORD=cadence_owner_dev
DB_APP_PASSWORD=cadence_app_dev

# Host ports. Change them if another program on your machine already uses one
# (for example a locally installed PostgreSQL on 5432).
HTTP_PORT=8080
DB_PORT=5432
MAIL_UI_PORT=8025
SMTP_PORT=1025
