# =============================================================================
#  .env.example: chép thành `.env` (cùng thư mục) rồi điền giá trị. `.env` đã gitignore, đừng commit.
#
#  application.yaml giữ CẤU TRÚC (đường dẫn API, Flyway, JPA), không sửa theo môi trường.
#  File .env giữ SỰ THẬT của MỘT môi trường: cổng, tên database, mật khẩu.
#  Docker Compose (infra/compose.yaml) và Spring (profile local) cùng đọc file này,
#  nên đổi một giá trị ở đây là cả hai cùng đổi.
#  Biến môi trường thật (CI, server) luôn thắng giá trị trong .env.
# =============================================================================

# ---------- Spring ----------
# Profile "local" mới đọc file này. Profile khác (staging) lấy biến từ môi trường thật.
SPRING_PROFILES_ACTIVE=local
# Cổng của backend. Đổi nếu 8080 trên máy bạn đã bị chương trình khác chiếm.
SERVER_PORT=8080

# ---------- Database: Docker Compose và Spring dùng chung ----------
DB_HOST=localhost
# Cổng Postgres mở ra máy bạn. Đổi (ví dụ 15432) nếu máy đã cài PostgreSQL chiếm 5432.
DB_PORT=5432
DB_NAME=cadence
# Mật khẩu của hai tài khoản tạo bởi infra/db/init/01-roles.sh (ADR-0014):
#   cadence_migrator: chỉ Flyway dùng, được tạo và sửa bảng
#   cadence_app:      ứng dụng dùng, chỉ đọc và ghi dữ liệu
# Chỉ dùng chữ, số, gạch dưới: dấu ' sẽ làm hỏng câu SQL trong script.
CADENCE_MIGRATOR_PASSWORD=change-me
CADENCE_APP_PASSWORD=change-me

# ---------- Chỉ container Postgres dùng ----------
# Tài khoản quản trị, chỉ dùng lúc khởi tạo database và khi sửa chữa bằng tay. Ứng dụng không dùng.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
