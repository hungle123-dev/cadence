<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle configuration — Spring Boot + Java 25
    Javadoc: DISABLED entirely — use OpenAPI @Operation instead
    Suppression file: config/checkstyle/checkstyle-suppressions.xml
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- =====================================================================
         File-level checks
    ===================================================================== -->

    <!-- No tabs allowed, use spaces only -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Files must end with a newline -->
    <module name="NewlineAtEndOfFile"/>

    <!-- Maximum line length: 120 characters -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(import|package).*|.*https?://.*"/>
    </module>

    <!-- Suppression filter -->
    <module name="SuppressionFilter">
        <property name="file" value="config/checkstyle/checkstyle-suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <!-- No @SuppressWarnings("checkstyle:...") in code: every exception lives in
         checkstyle-suppressions.xml, and covers a whole scope. -->

    <!-- =====================================================================
         Tree Walker
    ===================================================================== -->
    <module name="TreeWalker">

        <!-- =================================================================
             Naming Conventions
        ================================================================= -->

        <!-- Package: lowercase only — e.g. com.a1a.template.service -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Class / Interface / Enum / Record: PascalCase -->
        <module name="TypeName"/>

        <!-- Method in src/main: lowerCamelCase, no underscore -->
        <module name="MethodName">
            <property name="id" value="mainMethodName"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Method in src/test: lowerCamelCase parts joined by single underscores,
             e.g. listProducts_returns400WhenSizeInvalid (Google Java Style 5.2.3) -->
        <module name="MethodName">
            <property name="id" value="testMethodName"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-z0-9][a-zA-Z0-9]*)*$"/>
        </module>

        <!-- Local variables and parameters: camelCase -->
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>

        <!-- Field: camelCase -->
        <module name="MemberName"/>

        <!-- Constant (static final): UPPER_SNAKE_CASE -->
        <module name="ConstantName"/>

        <!-- Generic type parameter: T, E, K, V, T2 -->
        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z][0-9]?$"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="^[A-Z][0-9]?$"/>
        </module>

        <!-- =================================================================
             Import
        ================================================================= -->

        <!-- No wildcard imports: import java.util.* -->
        <module name="AvoidStarImport"/>

        <!-- No unused imports -->
        <module name="UnusedImports"/>

        <!-- Static imports: only allowed for test and assertion libraries -->
        <module name="AvoidStaticImport">
            <property name="excludes"
                      value="org.assertj.core.api.Assertions.*,
                             org.junit.jupiter.api.Assertions.*,
                             org.mockito.Mockito.*,
                             org.mockito.ArgumentMatchers.*,
                             org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*,
                             org.springframework.test.web.servlet.result.MockMvcResultMatchers.*,
                             com.tngtech.archunit.lang.syntax.ArchRuleDefinition.*,
                             com.tngtech.archunit.base.DescribedPredicate.*,
                             com.tngtech.archunit.core.domain.JavaClass.Predicates.*"/>
        </module>

        <!-- =================================================================
             Code Structure
        ================================================================= -->

        <!-- Always require braces for if/for/while/do -->
        <module name="NeedBraces"/>

        <!-- Left brace at end of line -->
        <module name="LeftCurly"/>

        <!-- Right brace on its own line -->
        <module name="RightCurly"/>

        <!-- Empty blocks must have an explanatory comment -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <!-- Maximum 8 parameters per method -->
        <module name="ParameterNumber">
            <property name="max" value="8"/>
        </module>

        <!-- Maximum cyclomatic complexity: 15 -->
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
        </module>

        <!-- =================================================================
             Coding Best Practices
        ================================================================= -->

        <!-- Do not compare Strings using == -->
        <module name="StringLiteralEquality"/>

        <!-- No magic numbers (except -1, 0, 1, 2) -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
        </module>

        <!-- Do not catch Exception/Throwable/RuntimeException directly -->
        <module name="IllegalCatch">
            <property name="illegalClassNames"
                      value="java.lang.Exception,
                             java.lang.Throwable,
                             java.lang.RuntimeException"/>
        </module>

        <!-- Do not throw generic Exception/Throwable -->
        <module name="IllegalThrows"/>

        <!-- Do not use System.out/err.print — use a logger instead -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use a logger instead of System.out/err.print"/>
        </module>

        <!-- TODO/FIXME: warning, not error -->
        <module name="TodoComment">
            <property name="severity" value="warning"/>
            <property name="format" value="(TODO|FIXME|HACK):"/>
        </module>

        <!-- =================================================================
             Modifiers
        ================================================================= -->

        <!-- Order: public protected private abstract default static final ... -->
        <module name="ModifierOrder"/>

        <!-- No redundant modifiers -->
        <module name="RedundantModifier"/>

        <!-- =================================================================
             Formatting (safety net — Spotless handles most formatting)
        ================================================================= -->

        <!-- Maximum 1 consecutive blank line between members -->
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
        </module>

        <!-- No whitespace after '(' or before ')' -->
        <module name="ParenPad"/>

        <!-- =================================================================
             Miscellaneous
        ================================================================= -->

        <!-- Filename must match the outer class name -->
        <module name="OuterTypeFilename"/>

        <!-- Utility classes must have a private constructor -->
        <module name="HideUtilityClassConstructor"/>

        <!-- Do not declare multiple variables on one line -->
        <module name="MultipleVariableDeclarations"/>

    </module>

</module>
